@model appPetShop.Models.RegistroViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Criar Conta";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-success text-white text-center py-3 rounded-top-3">
                <h4 class="mb-0 fw-bold">Criar Nova Conta</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Registrar" method="post">
                    @Html.AntiForgeryToken()

                    <h6 class="text-muted border-bottom pb-2 mb-3">Dados Pessoais</h6>
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Seu nome completo" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cpf" class="form-label fw-semibold"></label>
                            <input asp-for="Cpf" class="form-control" placeholder="Apenas números" />
                            <span asp-validation-for="Cpf" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefone" class="form-label fw-semibold"></label>
                            <input asp-for="Telefone" class="form-control" placeholder="Seu telefone" />
                            <span asp-validation-for="Telefone" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="text-muted border-bottom pb-2 mt-2 mb-3">Dados de Acesso</h6>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold"></label>
                        <input asp-for="Username" class="form-control" placeholder="Crie um utilizador" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Senha" class="form-label fw-semibold"></label>
                        <input asp-for="Senha" class="form-control" placeholder="Crie uma senha" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg fw-bold">Cadastrar</button>
                        <a asp-action="Login" class="btn btn-outline-secondary">Voltar para o Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>