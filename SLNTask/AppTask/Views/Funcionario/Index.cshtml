@model IEnumerable<AppTask.Models.Funcionario>

@{
    ViewData["Title"] = "Equipes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-white mb-1">Gestão de Equipes</h2>
        <p class="text-light-muted small mb-0">Colaboradores, cargos e lideranças cadastradas</p>
    </div>
    <a asp-action="Create" class="btn-emerald">
        <i class="fa-solid fa-user-plus"></i> Novo Colaborador
    </a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="glass-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar bg-gradient text-white fw-bold fs-6" style="width: 42px; height: 42px; background: linear-gradient(135deg, #6366f1, #8b5cf6);">
                            @(string.IsNullOrEmpty(item.Nome) ? "U" : item.Nome.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-white">@item.Nome</h5>
                            <span class="badge bg-secondary bg-opacity-25 text-info mt-1">@item.Cargo</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4 pt-2">
                    <div class="d-flex justify-content-between text-light-muted small">
                        <span><i class="fa-solid fa-user-tie me-1"></i> Gerente Direto</span>
                        <strong class="text-white">
                            @(item.GerenteNavigation != null ? item.GerenteNavigation.Nome : "Sem Gerente")
                        </strong>
                    </div>
                </div>

                <div class="d-flex gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-light w-100 border-0 bg-white bg-opacity-10 text-white">
                        <i class="fa-solid fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-light w-100 border-0 bg-white bg-opacity-10 text-info">
                        <i class="fa-solid fa-pen"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-light w-100 border-0 bg-white bg-opacity-10 text-danger">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>